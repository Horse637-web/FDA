Aim: To fit curves to data using least squares and regression techniques. 
 
Q1. Fit a straight line to:  
x : 1, 2, 3, 4, 5
y : 2, 4, 5, 8, 10
Code: 

x = [1, 2, 3, 4, 5] 
y = [2, 4, 5, 8, 10]  
n = len(x)  
sum_x = sum(x) 
sum_y = sum(y)  
sum_xy = 0 
sum_x2 = 0  
for i in range(n): 
    sum_xy = sum_xy + x[i] * y[i] 
    sum_x2 = sum_x2 + x[i] * x[i]  
# Calculate b 
b = (n * sum_xy - sum_x * sum_y) / (n * sum_x2 - sum_x * sum_x)  
# Calculate a 
a = (sum_y - b * sum_x) / n  
print("Straight line equation:") 
print("y =", round(a, 4), "+", round(b, 4), "x") 


Q2. Fit a quadratic curve to: 
x : 1, 2, 3, 4, 5
y : 4, 9, 16, 25, 36
Code: 

x = [1, 2, 3, 4, 5] 
y = [4, 9, 16, 25, 36]  
n = len(x)  
# Calculate required sums 
sx = sum(x) 
sy = sum(y)  
sx2 = 0 
sx3 = 0 
sx4 = 0 
sxy = 0 
sx2y = 0  
for i in range(n): 
    x2 = x[i] ** 2 
    x3 = x[i] ** 3 
    x4 = x[i] ** 4  
    sx2 = sx2 + x2 
    sx3 = sx3 + x3 
    sx4 = sx4 + x4  
    sxy = sxy + x[i] * y[i] 
    sx2y = sx2y + x2 * y[i]  
# Form augmented matrix 
A = [ 
    [n,   sx,  sx2,  sy], 
    [sx,  sx2, sx3,  sxy], 
    [sx2, sx3, sx4,  sx2y] 
]  
for i in range(3):  
    for j in range(i + 1, 3): 
        factor = A[j][i] / A[i][i]  
        for k in range(i, 4): 
            A[j][k] = A[j][k] - factor * A[i][k]  
c = A[2][3] / A[2][2]  
b = (A[1][3] - A[1][2] * c) / A[1][1]  
a = (A[0][3] - A[0][1] * b - A[0][2] * c) / A[0][0]  
print("Quadratic curve:") 
print("y =", round(a, 4), "+", round(b, 4), "x +", round(c, 4), "x^2")


Q3. Fit an exponential curve to: 
 x : 1, 2, 3, 4, 5
y : 2, 4, 8, 16, 32
Code:  

import math  
x = [1, 2, 3, 4, 5] 
y = [2, 4, 8, 16, 32]  
n = len(x)  
# Take natural logarithm of y 
Y = []  
for value in y: 
    Y.append(math.log(value))  
sum_x = sum(x) 
sum_Y = sum(Y)  
sum_xY = 0 
sum_x2 = 0  
for i in range(n): 
    sum_xY = sum_xY + x[i] * Y[i] 
    sum_x2 = sum_x2 + x[i] * x[i]  
# Calculate log(b) 
log_b = (n * sum_xY - sum_x * sum_Y) / \ 
        (n * sum_x2 - sum_x * sum_x)  
# Calculate log(a) 
log_a = (sum_Y - log_b * sum_x) / n  
# Convert back 
a = math.exp(log_a) 
b = math.exp(log_b)  
print("Exponential curve:") 
print("y =", round(a, 4), "*", round(b, 4), "^x") 
