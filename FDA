Practical No.5
Analyze time series data using Pandas operations.

CODE: 
import pandas as pd 
# Create time series data 
data = { 
    'Date': [ 
        '2025-01-01', '2025-01-02', '2025-01-03', 
        '2025-01-04', '2025-01-05' 
    ], 
    'Sales': [100, 120, 150, 130, 170] 
} 
# Create DataFrame 
df = pd.DataFrame(data) 
# Convert Date column to datetime 
df['Date'] = pd.to_datetime(df['Date']) 
# Set Date as index 
df.set_index('Date', inplace=True) 
print("Original Data:") 
print(df) 
# Calculate rolling average (3-day) 
df['Rolling_Avg'] = df['Sales'].rolling(window=3).mean() 
print("\nData with Rolling Average:") 
print(df) 
# Calculate daily change 
df['Daily_Change'] = df['Sales'].diff() 
print("\nData with Daily Change:") 
print(df)
